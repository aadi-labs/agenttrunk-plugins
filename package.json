{
  "name": "@agenttrunk/sdk",
  "version": "0.1.0",
  "description": "AgentTrunk TypeScript SDK and CLI for versioned agent context",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/aadi-labs/agenttrunk-plugins.git"},
  "homepage": "https://agenttrunk.ai",
  "engines": {"node": ">=22"},
  "exports": {".": {"types": "./dist/sdk/index.d.ts", "import": "./dist/sdk/index.js"}},
  "bin": {"agenttrunk": "./dist/cli/index.js"},
  "files": ["dist", "plugins", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {"@types/node": "^22.0.0", "typescript": "~5.9.3"}
}
