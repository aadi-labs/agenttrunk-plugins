{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "sdk/index.ts",
    "sdk/typescript/src/**/*.ts",
    "cli/**/*.ts"
  ]
}
