{
  "schemaVersion": 1,
  "name": "agenttrunk",
  "description": "Portable skill, SDK and CLI for authorized versioned agent context.",
  "repository": "https://github.com/aadi-labs/agenttrunk-plugins",
  "runtime": {
    "node": ">=22",
    "package": "@agenttrunk/sdk",
    "install": "source-tarball"
  },
  "api": {
    "origin": "https://api.agenttrunk.ai",
    "contract": "https://agenttrunk.ai/openapi.yaml",
    "authentication": "runtime-supplied short-lived bearer token",
    "selfServiceLogin": false,
    "mcp": false
  },
  "skills": [
    {
      "name": "agenttrunk",
      "path": "plugins/agenttrunk/skills/agenttrunk/SKILL.md"
    }
  ],
  "plugins": {
    "claude": "plugins/agenttrunk/.claude-plugin/plugin.json",
    "codex": "plugins/agenttrunk/.codex-plugin/plugin.json"
  },
  "documentation": [
    "README.md",
    "docs/setup.md",
    "docs/installation.md",
    "sdk/README.md",
    "cli/README.md",
    "docs/troubleshooting.md",
    "docs/maintaining.md",
    "examples/README.md",
    "llms.txt",
    "docs/sdk-generation.md",
    "sdk/typescript/README.md",
    "sdk/python/README.md",
    "sdk/go/README.md",
    "examples/clients/README.md",
    "docs/readiness.md",
    "docs/releases.md",
    "examples/workflows/README.md"
  ],
  "examples": [
    {
      "name": "quickstart",
      "readme": "examples/quickstart/README.md",
      "entrypoint": "examples/quickstart/index.mjs",
      "defaultEffect": "read"
    },
    {
      "name": "pinned-context",
      "readme": "examples/pinned-context/README.md",
      "entrypoint": "examples/pinned-context/index.mjs",
      "defaultEffect": "read"
    },
    {
      "name": "publish-skill",
      "readme": "examples/publish-skill/README.md",
      "entrypoint": "examples/publish-skill/index.mjs",
      "defaultEffect": "local-preview"
    },
    {
      "name": "release-review",
      "readme": "examples/release-review/README.md",
      "entrypoint": "examples/release-review/index.mjs",
      "defaultEffect": "read"
    },
    {
      "name": "cli",
      "readme": "examples/cli/README.md",
      "defaultEffect": "documented-commands"
    },
    {
      "name": "workspace-audit",
      "readme": "examples/workflows/workspace-audit/README.md",
      "entrypoint": "examples/workflows/workspace-audit/index.mjs",
      "defaultEffect": "local-preview"
    },
